{
	admin off
	http_port 8080
	https_port 8443
	email {$ACME_EMAIL}

	servers {
		protocols h1 h2 h3
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		max_header_size 32KB
		timeouts {
			read_body 90s
			read_header 10s
			write 120s
			idle 2m
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	# Only Cloudflare proxy ranges may reach the application.  Keep the host
	# firewall allowlist enabled as a second layer and refresh these ranges when
	# Cloudflare publishes changes.
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		request_body {
			max_size 60MB
		}

		reverse_proxy app:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https

			health_uri /healthz
			health_interval 30s
			health_timeout 5s
			health_status 200

			transport http {
				dial_timeout 5s
				response_header_timeout 90s
				keepalive 30s
			}
		}
	}

	respond 403
}
