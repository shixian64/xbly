# 复制为 .env。该文件只能保存非敏感配置；密码和 API Secret 必须放在
# docker/secrets/，不要写入这里。

TZ=Asia/Shanghai
BBW_DATA_ROOT=/var/lib/bbw

# Cloudflare DNS 中开启代理，并把 SSL/TLS 模式设置为 Full (strict)。
APP_DOMAIN=bbw.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL 非敏感标识。密码由 docker/init-secrets.sh 生成。
POSTGRES_DB=bbw
POSTGRES_USER=bbw

# Cloudflare R2：Bucket 必须保持私有，禁止公开开发 URL。
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_BUCKET=bbw-private-media

# Turnstile 仅在异常登录/连续失败后触发。Secret 写入 Docker secret；
# 尚未配置时留空，并确保应用不会把 Turnstile 标记为已启用。
TURNSTILE_SITE_KEY=

# 媒体归档只允许这些 HTTPS 主机。按实际腾讯云媒体域名收紧，不要使用裸 `*`。
MEDIA_ALLOWED_HOSTS=oss.banghua.xin,*.myqcloud.com,*.qcloud.com

# 初始管理员仅在数据库还没有管理员时创建。初始密码位于 Docker secret。
ADMIN_INITIAL_USERNAME=admin

# 镜像名可替换为自己的私有镜像仓库地址和不可变版本标签。
APP_IMAGE=bbw-app:local

# 当前不要手工递增；未来受审计的轮换流程会把旧版本保存在 credential_keyring。
BBW_CREDENTIAL_KEY_VERSION=1
BBW_REDIS_PREFIX=bbw
