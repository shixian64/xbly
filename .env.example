# =============================================================================
# BBW Docker Compose 非敏感配置模板
# =============================================================================
#
# 使用方法：
#   1. 复制本文件：cp .env.example .env
#   2. 只修改 .env，不要把真实部署值写回 .env.example。
#   3. 执行 bash docker/init-secrets.sh 创建密码和密钥。
#   4. 执行 docker compose config --quiet 检查变量是否完整。
#
# 安全要求：
#   - 本文件和 .env 只能保存非敏感配置。
#   - 数据库密码、加密主密钥、HMAC 密钥、管理员初始密码、腾讯 IM Secret、
#     RoomKit Token、R2 Secret Access Key、Turnstile Secret 必须保存在
#     docker/secrets/，不能写入 .env、Compose、文档或 Git。
#   - .env 已被 .gitignore 排除；服务器上仍应执行 chmod 600 .env。
#   - 所有 replace_with_*、example.com 示例在部署前都必须替换。
#
# Secret 文件由 docker/init-secrets.sh 创建或交互录入，主要包括：
#   postgres_password              PostgreSQL 密码
#   app_master_key                 用户凭据 AES-256-GCM 主密钥
#   credential_keyring             历史凭据密钥版本表，初始为 {}
#   phone_hmac_key                 手机号索引 HMAC 密钥
#   session_hmac_key               Session、IP 等标识 HMAC 密钥
#   admin_initial_password         初始超级管理员密码
#   txim_secret_key                腾讯 IM Secret Key
#   roomkit_business_token         RoomKit Business Token
#   r2_access_key_id               Cloudflare R2 Object Read & Write Access Key ID
#   r2_secret_access_key           Cloudflare R2 Object Read & Write Secret Access Key
#   turnstile_secret_key           Cloudflare Turnstile Secret，可留空
# =============================================================================


# -----------------------------------------------------------------------------
# 基础运行环境
# -----------------------------------------------------------------------------

# 所有容器使用的时区，影响应用显示时间、数据库会话时间和日志时间。
# 推荐保持 Asia/Shanghai；修改后应确保宿主机运维脚本使用相同时区语义。
TZ=Asia/Shanghai

# 宿主机持久数据根目录，当前用于保存 Caddy 证书和自动配置。
# 必须填写绝对路径，不能使用相对路径或 ~。
# 首次部署后执行：
#   sudo env BBW_DATA_ROOT=/var/lib/bbw bash docker/prepare-host.sh
# 如果修改此值，prepare-host.sh 使用的值也必须同步修改。
BBW_DATA_ROOT=/var/lib/bbw


# -----------------------------------------------------------------------------
# 正式域名、Cloudflare 和 HTTPS
# -----------------------------------------------------------------------------

# 对外访问的唯一正式域名。
# 只填写主机名，不要包含 https://、路径、端口或末尾斜杠。
# 示例：chat.example.com
# 部署前必须在 Cloudflare DNS 中创建代理记录，并开启橙色云代理。
APP_DOMAIN=bbw.example.com

# Caddy 申请和续期 TLS 证书时使用的联系邮箱。
# 应填写管理员可以长期接收告警的真实邮箱。
ACME_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# PostgreSQL 数据库名和登录用户名，只能使用普通数据库标识符。
# 这两项不是密码；数据库密码由 docker/secrets/postgres_password 提供。
# 数据库已经初始化后，不要随意修改，否则 Compose 会连接到不同数据库。
POSTGRES_DB=bbw
POSTGRES_USER=bbw


# -----------------------------------------------------------------------------
# Cloudflare R2 私有对象存储
# -----------------------------------------------------------------------------

# Cloudflare Dashboard 中显示的 Account ID，不是邮箱、域名或 API Token。
# 应为当前 R2 Bucket 所属账户的账户 ID。
R2_ACCOUNT_ID=replace_with_cloudflare_account_id

# 用于保存聊天图片、音频、视频和附件的私有 Bucket 名称。
# Bucket 必须预先创建，并保持私有：
#   - 禁止启用 R2.dev 公共开发地址；
#   - R2 Token 只授予该 Bucket 所需的对象读写权限；
#   - 浏览器只通过应用签发的短期 GET 地址访问对象。
# 修改 Bucket 前必须迁移旧对象和数据库中的对象归属元数据。
R2_BUCKET=bbw-private-media


# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------

# Turnstile Site Key，会随网页下发给浏览器，因此不是 Secret。
# 当前采用异常登录触发模式，并非每次登录固定显示。
# 暂不启用时保持空值，同时让 docker/secrets/turnstile_secret_key 为空。
# 启用时必须同时：
#   1. 填写正式站点对应的 Site Key；
#   2. 把匹配的 Secret Key 写入 turnstile_secret_key；
#   3. 在 Cloudflare 中仅允许 APP_DOMAIN 对应的主机名。
# Site Key 与 Secret 只配置其中一个会导致应用拒绝启动。
TURNSTILE_SITE_KEY=


# -----------------------------------------------------------------------------
# 上游媒体归档安全白名单
# -----------------------------------------------------------------------------

# Worker 只允许从这些 HTTPS 主机下载需要归档到 R2 的媒体。
# 多个主机使用英文逗号分隔；允许精确域名和形如 *.example.com 的子域后缀。
# 不要填写协议、路径、端口、IP 地址，也不要使用单独的 * 放开全部主机。
# 上线后应根据真实抓到的上游媒体域名继续收紧，而不是扩大白名单。
MEDIA_ALLOWED_HOSTS=oss.banghua.xin,*.myqcloud.com,*.qcloud.com


# -----------------------------------------------------------------------------
# 初始超级管理员
# -----------------------------------------------------------------------------

# 仅在 admin_users 表为空时创建第一个且唯一的超级管理员。
# 用户名长度为 3 到 80 个字符，推荐使用小写 ASCII 名称。
# 初始密码不在这里配置，而是读取 docker/secrets/admin_initial_password。
# 管理员创建后修改本值不会重命名已有账号，也不会重置密码。
ADMIN_INITIAL_USERNAME=admin


# -----------------------------------------------------------------------------
# 应用镜像
# -----------------------------------------------------------------------------

# Compose 构建后使用的应用镜像名称。
# 本机或单机首次部署可以保留 bbw-app:local。
# 正式长期运行建议替换为私有镜像仓库中的不可变版本标签或 digest，例如：
#   registry.example.com/bbw/app:2026.07.17-1
# 不要长期使用 latest；更新前应记录当前可回滚镜像版本。
APP_IMAGE=bbw-app:local


# -----------------------------------------------------------------------------
# 凭据密钥版本
# -----------------------------------------------------------------------------

# 当前 AES-256-GCM 凭据主密钥的正整数版本号。
# 新部署必须保持 1。
# 当前项目尚未提供自动、原子且可验证回滚的密钥轮换工具，因此：
#   - 不要手工递增；
#   - 不要直接覆盖 app_master_key；
#   - 不要删除 credential_keyring 中仍有旧密文引用的版本。
# 错误修改可能导致已保存的上游账号、密码、Token、TOTP 和原始响应永久不可读。
BBW_CREDENTIAL_KEY_VERSION=1


# -----------------------------------------------------------------------------
# Redis 键空间
# -----------------------------------------------------------------------------

# Redis 内 Session、限流、锁和 RQ 队列键使用的统一前缀。
# 当前 Compose 使用专用 Redis，通常保持 bbw 即可。
# 多套环境误用同一个 Redis 时必须设置不同前缀，例如 bbw_test、bbw_prod。
# 已经运行后修改会使旧 Session、限流状态和调度锁暂时不可见。
BBW_REDIS_PREFIX=bbw
